
model "Web service" {

  nodes {
    user    [type: person,        label: "User"]
    client  [type: juju-software, label: "Client"]
    api_pod [type: container,     label: "API pod"] {
      api    [type: juju-software, label: "API server"]
      worker [type: juju-software, label: "Worker"]
    }
    cache [type: external,  label: "Cache"]
    db    [type: database,  label: "Database"]
  }

  edges {
    user   -> client  [type: control, label: "uses"]

    // Container-level edges (overview / collapsed pod)
    client  -> api_pod [type: control, label: "HTTP"]
    api_pod -> cache   [type: control, label: "read / write"]
    api_pod -> db      [type: control, label: "query / persist"]

    // Inner edges (pod-detail / expanded pod)
    client -> api    [type: api,    label: "HTTP request"]
    api    -> cache  [type: api,    label: "read / write"]
    api    -> worker [type: stream, label: "job queue"]
    worker -> db     [type: data,   label: "persist"]
    api    -> db     [type: api,    label: "query"]
  }

  behaviours {
    behaviour "Handle request" {
      client -> api:    call  "GET /resource"
      api    -> cache:  call  "cache lookup"
      cache  -> api:    return "miss"
      api    -> db:     call  "query"
      db     -> api:    return "rows"
      api    -> cache:  call  "populate cache"
      api    -> client: return "200 OK"
    }
  }

  style { extends: juju }
}

diagram "Overview" from "Web service" {
  select {
    nodes: user client api_pod cache db
    edges: type control
    collapse: api_pod
  }
  positions {
    user      left-of client   gap: 40
    user      align-middle client
    client    left-of api_pod  gap: 60
    client    align-middle api_pod
    cache     above api_pod    gap: 40
    cache     align-centre api_pod
    db        right-of api_pod gap: 60
    db        align-middle api_pod
  }
}

diagram "Pod detail" from "Web service" {
  select {
    nodes: client api_pod db cache
    edges: type api type stream
  }
  positions {
    client    left-of api_pod  gap: 60
    client    align-middle api_pod
    cache     above api_pod    gap: 40
    cache     align-centre api_pod
    db        right-of api_pod gap: 60
    db        align-middle api_pod
    api_pod   direction: right
    api       same-width worker
  }
}

sequence "Handle request" from "Web service" {
  select { behaviour: "Handle request" }
}
