// topology.ggarch — deployment topology diagrams
//
// Demonstrates: nested containers, typed edges, node lifecycle (init nodes
// render with a dashed border), selective zoom (collapse/expand).
//
// Colour legend (juju preset):
//   Orange fill         — Juju software (controller agent, unit agent)
//   White/orange border — Charm code
//   Gray fill           — External/workload nodes (Pebble, workload services);
//                         colour encodes ownership, not entity category
//   Dashed arrow        — Long-lived stream (Juju API websocket)
//   Solid arrow         — Direct control or API call
//   Dotted arrow        — IPC (hook commands: unit agent ↔ charm, Unix socket)
//
// Caption for topology-0 (K8s deployment topology):
//   A live Kubernetes deployment. The controller pod (left) runs the
//   controller agent (jujud), which provisions pods via the Kubernetes cloud
//   API and fetches charms from Charmhub. The dashed arrow is the Juju API
//   websocket — a long-lived stream over which the unit agent watches the
//   controller. Inside the unit pod (right): the unit agent dispatches the
//   charm (white/orange border). The workload container is collapsed here;
//   see Unit focus for its internal structure.
//
// Caption for topology-1 (Unit focus):
//   Zoomed in on the unit pod. The controller pod is collapsed to an opaque
//   box — context only. Inside the unit pod: the unit agent dispatches the
//   charm; the charm drives Pebble over the Pebble HTTP API; Pebble manages
//   the workload services. Gray = external/workload nodes Juju operates
//   but does not own.

model "Juju" {

  nodes {
    controller_pod [type: container, label: "Controller pod"] {
      init_containers [type: container, label: "Init containers"] {
        config_seed [type: juju-software, label: "controller-config-seed",
                     lifecycle: init]
        charm_init  [type: juju-software, label: "charm-init",
                     lifecycle: init]
      }
      jujud [type: juju-software, label: "Controller agent\n(jujud)"]
    }
    unit_pod [type: container, label: "Unit pod"] {
      unit_agent        [type: juju-software, label: "Unit agent"]
      charm             [type: charm,         label: "Charm"]
      workload_container [type: container,    label: "Workload"] {
        pebble   [type: pebble,   label: "Pebble"]
        workload [type: workload, label: "Workload services"]
      }
    }

    k8s      [type: external, label: "Kubernetes cloud"]
    charmhub [type: external, label: "Charmhub"]
  }

  edges {
    jujud          -> k8s        [type: control]
    jujud          -> charmhub   [type: api]
    jujud          -> unit_agent [type: stream]
    // Container-level edge for unit_focus (when controller_pod collapsed)
    controller_pod -> unit_pod   [type: event]
    unit_agent     -> charm             [type: control]
    charm          -> unit_agent        [type: ipc]
    // Container-level edge for topology-0 (collapsed workload_container)
    charm          -> workload_container [type: api]
    // Fine-grained edges inside workload_container (visible in unit_focus)
    charm          -> pebble            [type: api]
    pebble         -> workload          [type: control]
  }

  style { extends: juju }
}

diagram "K8s deployment topology" from "Juju" {
  select {
    nodes: k8s charmhub controller_pod unit_pod
    edges: type api type stream type control type ipc
    collapse: init_containers workload_container
  }
  positions {
    controller_pod left-of unit_pod      gap: 80
    controller_pod align-middle unit_pod
    k8s            above jujud           gap: 40
    k8s            align-centre jujud
    k8s            same-width jujud
    charmhub       below jujud           gap: 40
    charmhub       align-centre jujud
    charmhub       same-width jujud
    unit_pod       direction: right
    jujud          min-width: 160
  }
}

diagram "Unit focus" from "Juju" {
  select {
    nodes: controller_pod unit_pod
    collapse: controller_pod
  }
  positions {
    controller_pod left-of unit_pod  gap: 80
    controller_pod align-middle unit_pod
    unit_pod       direction: right
  }
}
