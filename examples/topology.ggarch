// topology.ggarch — deployment topology diagram
//
// Shows: nested containers, typed edges, lifecycle (init nodes shown with
// dashed border), Juju colour preset.
//
// Two views: the full K8s deployment topology and a selective zoom
// (controller pod collapsed, unit pod fully expanded).

model "Juju" {

  nodes {
    controller_pod [type: container, label: "Controller pod"] {
      config_seed [type: juju-software, label: "controller-config-seed",
                   lifecycle: init]
      charm_init  [type: juju-software, label: "charm-init",
                   lifecycle: init]
      jujud       [type: juju-software, label: "jujud"]
      apiserver   [type: juju-software, label: "API server"]
      dqlite      [type: database,      label: "Dqlite"]
    }

    unit_pod [type: container, label: "Unit pod"] {
      unit_agent [type: juju-software, label: "Unit agent"]
      charm      [type: charm,         label: "Charm"]
      pebble     [type: pebble,        label: "Pebble"]
      workload   [type: workload,      label: "Workload"]
    }

    k8s      [type: external, label: "Kubernetes cloud"]
    charmhub [type: external, label: "Charmhub"]
  }

  edges {
    // Controller internal
    apiserver -> dqlite     [type: data]
    jujud     -> dqlite     [type: data]
    apiserver -> charmhub   [type: api]

    // Controller to cloud and units
    jujud          -> k8s        [type: control]
    apiserver      -> unit_agent [type: stream]
    controller_pod -> unit_pod   [type: stream]

    // Unit agent control loop
    unit_agent -> charm     [type: control]
    charm      -> unit_agent[type: ipc]
    charm      -> pebble    [type: api]
    pebble     -> workload  [type: control]
  }

  style { extends: juju }
}

diagram "K8s deployment topology" from "Juju" {
  select {
    nodes: k8s charmhub controller_pod unit_pod
    edges: type api type stream type control type ipc type data
  }
  positions {
    controller_pod left-of unit_pod      gap: 80
    controller_pod align-middle unit_pod
    k8s            above controller_pod  gap: 40
    k8s            align-centre controller_pod
    charmhub       below controller_pod  gap: 40
    charmhub       align-centre controller_pod
    jujud          align-middle unit_agent
    unit_pod       direction: right
    jujud          min-width: 160
  }
  annotations {
    box [nodes: "config_seed charm_init",
         label: "init (run once at startup)",
         style: dashed, color: "#888888"]
  }
}

diagram "Unit focus" from "Juju" {
  select {
    nodes: controller_pod unit_pod
    collapse: controller_pod
  }
  positions {
    controller_pod left-of unit_pod  gap: 80
    controller_pod align-middle unit_pod
  }
}
