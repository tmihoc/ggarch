// instances.ggarch — type instantiation diagram
//
// Demonstrates: a single declared node type (unit_pod) rendered as multiple
// labelled instances in one view. The type is declared once in the model;
// the view stamps out N copies with distinct labels. Renaming the type or
// changing its style updates all instances automatically.
//
// Caption:
//   Type instantiation. The model declares one unit_pod type; the view
//   renders it twice as unit/0 for two different applications. The
//   controller pod (collapsed, above) drives both unit agents over the
//   Juju API websocket. Both unit pods are structurally identical — same
//   agent, charm, and workload — because they derive from the same type
//   declaration. Only their labels differ.

model "Juju" {

  nodes {
    controller_pod [type: container, label: "Controller pod"] {
      jujud [type: juju-software, label: "Controller agent\n(jujud)"]
    }

    unit_pod [type: container, label: "Unit pod"] {
      unit_agent [type: juju-software, label: "Unit agent"]
      charm      [type: charm,         label: "Charm"]
      workload   [type: workload,      label: "Workload"]
    }
  }

  edges {
    controller_pod -> unit_pod   [type: stream]
    jujud          -> unit_agent [type: stream]
    unit_agent     -> charm      [type: control]
    charm          -> workload   [type: control]
  }

  style { extends: juju }
}

diagram "Two-application deployment" from "Juju" {
  select {
    nodes: controller_pod unit_pod
    collapse: controller_pod
    instances: unit_pod [
      { id: app1_unit0, label: "postgresql/0" },
      { id: app2_unit0, label: "pgbouncer/0"  }
    ]
  }
  positions {
    controller_pod left-of app1_unit0  gap: 60
    controller_pod align-middle app1_unit0
    app1_unit0     above app2_unit0    gap: 20
    app1_unit0     align-left app2_unit0
  }
}
