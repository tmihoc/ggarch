// sequence-par-opt.ggarch — sequence diagram with par, opt, and activation bars
//
// Demonstrates: par block (green-tinted parallel lanes — steps that can
// proceed concurrently), opt block (optional fragment — executed only when
// a condition holds), and activation bars (the shaded rectangle on a
// lifeline showing the span during which a participant is active handling
// a call).
//
// Caption:
//   The integrate operation. After the controller writes the relation record
//   it fans out to both unit agents in parallel (green [par] region — the
//   two watcher notifications can be delivered concurrently). Each agent runs
//   its relation-created hook and writes its relation data bag to the
//   controller. The [opt] region fires only if the data changed: the
//   controller notifies unit agent B, which runs relation-changed. The
//   shaded bars on the lifelines are activation bars — they show the
//   interval during which a participant is actively processing a call.

model "Notify" {

  nodes {
    client     [type: juju-software, label: "Client"]
    controller [type: juju-software, label: "Controller"]
    agent_a    [type: juju-software, label: "Unit agent A"]
    agent_b    [type: juju-software, label: "Unit agent B"]
  }

  edges {
    client     -> controller [type: api]
    controller -> agent_a    [type: stream]
    controller -> agent_b    [type: stream]
    agent_a    -> controller [type: api]
    agent_b    -> controller [type: api]
  }

  behaviours {
    behaviour "integrate" {
      client     -> controller: call  "juju integrate A B"
      controller -> controller: self  "write relation record"
      par {
        controller -> agent_a: async "watcher fires"
        controller -> agent_b: async "watcher fires"
      }
      agent_a -> controller: call   "relation-created"
      agent_b -> controller: call   "relation-created"
      agent_a -> controller: call   "write relation data"
      opt "if data changed" {
        controller -> agent_b: async "watcher fires (data)"
        agent_b    -> controller: call "relation-changed"
      }
      controller -> client: return "integrate complete"
    }
  }

  style { extends: juju }
}

sequence "Integrate" from "Notify" {
  select { behaviour: "integrate" }
}
