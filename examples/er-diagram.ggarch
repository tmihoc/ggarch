// er-diagram.ggarch — entity-relationship diagram
//
// Demonstrates: record nodes with named fields; PK/FK/nullable markers;
// right-aligned field type annotations; field-qualified edge endpoints
// that anchor at the exact field row rather than the node centroid.
//
// Caption:
//   The five core tables of a Juju model database. Orange header = table
//   name. PK / FK badges identify primary and foreign key columns.
//   A trailing ? marks nullable columns. Field types are shown right-
//   aligned in italic. Arrows connect the FK column in the child table to
//   the PK column in the parent; they anchor at the exact field row so the
//   relationship is unambiguous even in dense diagrams. Every FK column
//   is drawn exactly once — the arrow is where the pointer lives — and
//   labels are aligned to the arrow: child-first ("belongs to"), the
//   direction the storage layer states.

model "JujuSchema" {

  nodes {

    application [type: record, label: "application"] {
      fields {
        uuid       [label: "uuid",       type: "uuid", pk: true]
        name       [label: "name",       type: "text"]
        charm_uuid [label: "charm_uuid", type: "uuid", fk: true]
        life       [label: "life",       type: "text"]
      }
    }

    unit [type: record, label: "unit"] {
      fields {
        uuid         [label: "uuid",         type: "uuid", pk: true]
        app_uuid     [label: "app_uuid",     type: "uuid", fk: true]
        machine_uuid [label: "machine_uuid", type: "uuid", fk: true,
                      null: true]
        name         [label: "name",         type: "text"]
        life         [label: "life",         type: "text"]
      }
    }

    machine [type: record, label: "machine"] {
      fields {
        uuid        [label: "uuid",        type: "uuid", pk: true]
        provider_id [label: "provider_id", type: "text", null: true]
        life        [label: "life",        type: "text"]
      }
    }

    charm [type: record, label: "charm"] {
      fields {
        uuid     [label: "uuid",     type: "uuid", pk: true]
        source   [label: "source",   type: "text"]
        revision [label: "revision", type: "int"]
      }
    }

    relation [type: record, label: "relation"] {
      fields {
        uuid  [label: "uuid",  type: "uuid", pk: true]
        app_a [label: "app_a", type: "uuid", fk: true]
        app_b [label: "app_b", type: "uuid", fk: true]
        life  [label: "life",  type: "text"]
      }
    }

  }

  edges {
    unit.app_uuid          -> application.uuid  [type: data, label: "belongs to"]
    unit.machine_uuid      -> machine.uuid      [type: data, label: "provisions"]
    application.charm_uuid -> charm.uuid        [type: data, label: "deploys"]
    relation.app_a         -> application.uuid  [type: data, label: "joins"]
    relation.app_b         -> application.uuid  [type: data, label: "joins"]
  }

  style { extends: juju }

}

diagram "Juju model schema" from "JujuSchema" {
  select {
    nodes: application unit machine charm relation
    edges: type data
  }
  positions {
    application left-of unit        gap: 100
    application align-middle unit
    unit        left-of machine     gap: 80
    unit        align-middle machine
    charm       above application   gap: 50
    charm       align-centre application
    relation    below application   gap: 50
    relation    align-centre application
  }
}
