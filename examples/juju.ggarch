// Juju architecture — ggarch model
// Covers the K8s deployment topology and the hook execution sequence.
// This is a live working example that exercises all major ggarch features.

model "Juju" {

  nodes {
    user [type: person, label: "User"]
    client [type: juju-software, label: "Client"]

    controller_pod [type: container, label: "Controller pod",
                    cardinality: one-per-model] {
      config_seed [type: juju-software, label: "controller-config-seed",
                   lifecycle: init, cardinality: one-per-model]
      charm_init  [type: juju-software, label: "charm-init",
                   lifecycle: init, cardinality: one-per-model]
      jujud       [type: juju-software, label: "jujud",
                   cardinality: one-per-model]
      apiserver   [type: juju-software, label: "API-server container",
                   cardinality: one-per-model]
      dqlite      [type: database, label: "Dqlite",
                   cardinality: one-per-model]
    }

    unit_pod [type: container, label: "Unit pod",
              cardinality: one-per-unit] {
      unit_agent  [type: juju-software, label: "Unit agent (containeragent)",
                   cardinality: one-per-unit]
      charm       [type: charm, label: "Charm",
                   lifecycle: ephemeral, cardinality: one-per-unit]
      workload    [type: workload, label: "Workload container",
                   cardinality: one-per-unit]
      pebble      [type: pebble, label: "Pebble",
                   cardinality: one-per-unit]
    }

    k8s    [type: infrastructure, label: "Kubernetes cluster"]
    charmhub [type: external, label: "Charmhub"]
  }

  edges {
    // User intent path
    user       -> client       [type: control, label: "juju deploy / integrate / ..."]
    client     -> apiserver    [type: api, label: "Juju API", protocol: "websocket-rpc"]

    // Controller internals
    apiserver  -> dqlite       [type: data, label: "read/write goal state"]
    jujud      -> dqlite       [type: data, label: "read/write goal state"]
    apiserver  -> charmhub     [type: api, label: "fetch charm"]

    // Controller to unit
    apiserver  -> unit_agent   [type: stream, label: "watcher", protocol: "websocket"]

    // Unit agent control loop
    unit_agent -> charm        [type: control, label: "exec dispatch"]
    charm      -> unit_agent   [type: ipc, label: "hook commands", protocol: "unix-socket"]
    charm      -> pebble       [type: api, label: "Pebble API", protocol: "http"]
    pebble     -> workload     [type: control, label: "manages services"]

    // Infrastructure
    k8s        -> controller_pod [type: control, label: "schedules pod"]
    k8s        -> unit_pod       [type: control, label: "schedules pod"]
    // Bootstrap / provisioning
    client     -> k8s          [type: api, label: "provision controller"]
    apiserver  -> k8s          [type: api, label: "provision unit pod"]
    jujud      -> client       [type: api, label: "API ready"]
  }

  behaviours {

    behaviour "hook execution" {
      apiserver -> unit_agent: async "watcher fires"
      unit_agent -> unit_agent: self "snapshot remote state"
      unit_agent -> unit_agent: self "resolve next hook"
      unit_agent -> charm: call "exec dispatch"
      loop "during hook" {
        charm -> unit_agent: call "hook command"
        unit_agent -> apiserver: call "serve via API"
        apiserver -> unit_agent: return
        unit_agent -> charm: return
      }
      alt "exit 0" {
        charm -> unit_agent: return "success"
        unit_agent -> apiserver: call "flush writes"
      } else "failure" {
        charm -> unit_agent: return "failure"
        unit_agent -> apiserver: call "discard writes, set unit error"
      }
    }

    behaviour "bootstrap k8s" {
      user -> client: call "juju bootstrap"
      client -> k8s: call "authenticate"
      k8s -> client: return "OK"
      client -> k8s: call "create namespace, deploy controller pod"
      k8s -> client: return "pod scheduled"
      config_seed -> config_seed: self "run once"
      charm_init -> charm_init: self "run once"
      jujud -> jujud: self "start API server"
      jujud -> dqlite: call "initialise database"
      jujud -> client: return "API ready"
    }

    behaviour "deploy application" {
      user -> client: call "juju deploy <charm>"
      client -> apiserver: call "deploy application"
      apiserver -> dqlite: call "write goal state"
      apiserver -> charmhub: call "fetch charm"
      apiserver -> k8s: call "create unit pod"
      k8s -> unit_pod: call "schedule"
      apiserver -> unit_agent: async "watcher fires"
      unit_agent -> charm: call "install hook"
      charm -> pebble: call "start workload services"
      pebble -> workload: call "start services"
      charm -> unit_agent: return "success"
      unit_agent -> apiserver: call "flush writes"
    }
  }

  style {
    extends: juju

    person {
      shape: person
      fill: ""
      stroke: ""
    }

    juju-software {
      fill: "#E95420"
      font-color: "#FFFFFF"
      stroke: "#C74210"
    }

    charm {
      fill: "#FFFFFF"
      stroke: "#E95420"
      font-color: "#000000"
    }

    workload {
      fill: "#4A90D9"
      font-color: "#FFFFFF"
      stroke: "#2C6FAC"
    }

    pebble {
      fill: "#74AADC"
      font-color: "#FFFFFF"
      stroke: "#4A90D9"
    }

    database {
      shape: cylinder
      fill: "#FFF8E1"
      stroke: "#F9A825"
      font-color: "#333333"
    }

    container {
      fill: "#F5F5F5"
      stroke: "#CCCCCC"
      font-color: "#333333"
    }

    infrastructure {
      fill: "#E8F5E9"
      stroke: "#66BB6A"
      font-color: "#1B5E20"
    }

    external {
      fill: "#F5F5F5"
      stroke: "#AAAAAA"
      font-color: "#444444"
    }

    @dark {
      container {
        fill: "#1E1E2E"
        stroke: "#555555"
        font-color: "#CDD6F4"
      }
      infrastructure {
        fill: "#1A2E1A"
        stroke: "#66BB6A"
        font-color: "#A5D6A7"
      }
      external {
        fill: "#2A2A2A"
        stroke: "#666666"
        font-color: "#CCCCCC"
      }
      database {
        fill: "#2A2200"
        stroke: "#F9A825"
        font-color: "#FFE082"
      }
    }
  }
}

// -----------------------------------------------------------------------
// Diagram views
// -----------------------------------------------------------------------

diagram "K8s deployment topology" from "Juju" {
  select {
    nodes: controller_pod unit_pod k8s charmhub
    environment: kubernetes
  }
  positions {
    k8s above controller_pod gap: 60
    k8s align-centre controller_pod
    controller_pod left-of unit_pod gap: 60
    controller_pod align-middle unit_pod
    charmhub right-of unit_pod gap: 60
    charmhub align-middle unit_pod
  }
  annotations {
    box [nodes: "config_seed charm_init",
         label: "init containers (run once at startup)",
         style: dashed, color: "#888888"]
    box [nodes: "apiserver jujud dqlite",
         label: "persistent processes",
         style: solid, color: "#E95420"]
  }
}

diagram "Unit focus" from "Juju" {
  select {
    nodes: controller_pod unit_pod
    collapse: controller_pod
    expand: unit_pod
  }
  positions {
    controller_pod above unit_pod gap: 80
    controller_pod align-centre unit_pod
  }
  annotations {
    box [nodes: "unit_agent charm",
         label: "charm control loop",
         style: dashed, color: "#E95420"]
  }
}

diagram "Two-application deployment" from "Juju" {
  select {
    nodes: controller_pod unit_pod
    collapse: controller_pod
    instances: unit_pod [
      { id: app1_unit0, label: "App 1 / Unit 0" },
      { id: app2_unit0, label: "App 2 / Unit 0" }
    ]
  }
  positions {
    controller_pod above app1_unit0 gap: 60
    app1_unit0 left-of app2_unit0 gap: 40
    app1_unit0 align-middle app2_unit0
  }
}

// -----------------------------------------------------------------------
// Sequence views
// -----------------------------------------------------------------------

sequence "Hook execution" from "Juju" {
  select {
    behaviour: "hook execution"
  }
  annotations {
    box [nodes: "unit_agent charm",
         label: "unit agent + charm",
         style: dashed, color: "#E95420"]
  }
}

sequence "Bootstrap K8s" from "Juju" {
  select {
    behaviour: "bootstrap k8s"
  }
}
